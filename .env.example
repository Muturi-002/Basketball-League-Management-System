# Database Configuration
ORACLE_DRIVER=oracle
DB_USER=<db_user>
DB_PASSWORD=<password>
ORACLE_CONFIG_DIR=<path_to_your_wallet>
ORACLE_CONNECTION_STRING=<atp_connect_string>
# Directory containing the DB wallet (used as WALLET/ORACLE_CONFIG_DIR)
# Optional: additional envs can be set as needed (no native client required)

# Mailer Configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
GMAIL_ADDRESS=<your_gmail_address>
GMAIL_APP_PASSWORD=<your_gmail_app_password> # Go to your Google Account management settings, search for 'App Passwords', create a unique name, and copy the 16-word password provided before clicking 'Done'
MAILER_FROM_NAME=KBF Premier League
SITE_URL=https://kbfpremierleague.example.com