# Database Configuration
ORACLE_DRIVER=oracle
DB_USER=<db_user>
DB_PASSWORD=<password>
ORACLE_CONFIG_DIR=<path_to_your_wallet>
ORACLE_CONNECTION_STRING=<atp_connect_string>
# Directory containing the DB wallet (used as WALLET/ORACLE_CONFIG_DIR)
# Optional: additional envs can be set as needed (no native client required)